# Copie este archivo como .env y reemplace los valores. El archivo .env NO se versiona.
# Docker Compose lo usa para el contenedor y Spring Boot lo importa al arrancar.

# --- Contenedor PostgreSQL (docker-compose.yml) ---
# Superusuario del contenedor: solo para administración; la aplicación no lo usa.
POSTGRES_DB=sierra_alta
POSTGRES_USER=sierra_alta
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_PORT=5432

# --- Backend Spring Boot ---
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/sierra_alta
# Cuenta de la aplicación: solo lectura y escritura de datos (sin DDL).
DB_USERNAME=sierra_alta_app
DB_PASSWORD=cambie-esta-clave-app
# Cuenta dueña del esquema, usada solo por Flyway al aplicar migraciones.
DB_MIGRATION_USERNAME=sierra_alta_migrator
DB_MIGRATION_PASSWORD=cambie-esta-clave-migraciones

# Primer administrador: se crea solo si no existe ningún administrador activo.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=cambie-esta-clave-admin

# Cuentas de demostración (planeador, supervisor, analista); solo con el perfil "dev".
DEMO_USERS_PASSWORD=cambie-esta-clave-demo

# Origen del frontend React (Vite). Varios orígenes separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# true cuando el backend se sirve por HTTPS.
SESSION_COOKIE_SECURE=false
