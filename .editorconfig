# Formato común para cualquier editor (IntelliJ, VS Code, Eclipse).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = tab
max_line_length = 120

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.{xml,sh}]
indent_style = tab

[*.sql]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf
